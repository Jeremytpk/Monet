{
  "name": "monet-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-monet \"node --test rules/\"",
    "test:functions": "firebase emulators:exec --only firestore,functions --project demo-monet \"node --test functions/\"",
    "test": "npm run test:rules && npm run test:functions"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.7.0",
    "firebase-admin": "^12.7.0"
  }
}
