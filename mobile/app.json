{
  "expo": {
    "name": "Monet",
    "slug": "monet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "monet",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jerttech.monet",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B5D4B"
      },
      "package": "com.jerttech.monet",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F5F7F4",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0E1A17"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Monet to access your photos for your profile picture.",
          "cameraPermission": "Allow Monet to use your camera to take a profile photo."
        }
      ]
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2921d89b-9c10-4e27-a87f-325abc6dbe5b"
      }
    }
  }
}
