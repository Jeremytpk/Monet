rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the current user is an admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'Admin'];
    }

    // Allow admins to read and write all documents globally
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Fields a user may set on their own profile. Everything else (wallet_balance, role,
    // wallet_id, card/bank data, mcp_id…) is written only by Cloud Functions or admins.
    function selfEditableFields() {
      return ['email', 'name', 'phone', 'photoURL', 'created_at', 'updated_at', 'force_logout'];
    }

    // Users: private record (balance, email, payment details). Owner and admins only.
    // Other users see the public copy in profiles/{uid}.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(selfEditableFields());
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(selfEditableFields())
        && (!('force_logout' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.force_logout == false);
    }

    // Public profiles (name, phone, photo, kiosk agent id) for recipient search.
    // Written only by the syncPublicProfile Cloud Function.
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Transactions: users can read their own (as sender or receiver)
    match /users/{userId}/transactions/{txId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false; // only Cloud Functions write
    }

    // Ads: public read (home banner), writes restricted to Admin users
    match /ads/{adId} {
      // Allow everyone to read ads so the home banner can display them without permission errors
      allow read: if true;

      // Only allow authenticated users whose profile role (case-insensitive) is 'admin' to write
      allow create, update, delete: if isAdmin();
    }

    // MPA Accounts: only the MCP (Money Partner Account owner) can read/write their own
    match /mpa_accounts/{mcpUid} {
      allow read, write: if request.auth != null && request.auth.uid == mcpUid;
    }

    // MPA Transactions: only the MCP can read their own transaction history; only Cloud Functions write
    match /mpa_accounts/{mcpUid}/transactions/{txId} {
      allow read: if request.auth != null && request.auth.uid == mcpUid;
      allow create, update, delete: if false; // only Cloud Functions write
    }

    // Kiosk Transactions: users can read their own pending codes; Cloud Functions manage writes
    match /kiosk_transactions/{txId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.user_uid ||
        request.auth.uid == resource.data.mcp_uid
      );
      allow create, update, delete: if false; // only Cloud Functions write
    }
  }
}
